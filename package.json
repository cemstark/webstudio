{
  "name": "webstudio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "test:e2e": "playwright test tests/e2e/experience.spec.ts --project=chromium",
    "test:cross-browser": "playwright test tests/e2e/cross-browser.spec.ts --project=firefox --project=webkit",
    "qa:spline-cross-browser": "node scripts/spline-cross-browser.mjs",
    "qa:screenshots": "playwright test tests/e2e/visual.spec.ts --project=chromium-hardware",
    "qa:lighthouse": "node scripts/lighthouse.mjs"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "dependencies": {
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.98",
    "next": "16.2.11",
    "nodemailer": "^9.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "lighthouse": "^13.4.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "$sharp"
  }
}
